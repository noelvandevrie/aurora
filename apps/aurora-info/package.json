{
  "name": "@gewis/aurora-info",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "serve": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src --max-warnings=1",
    "lint-fix": "eslint src --fix",
    "docker-build": "docker build -f Dockerfile -t aurora-info ../.."
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "@gewis/aurora-api-client": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "6.4.3",
    "vite-plugin-svgr": "4.5.0",
    "vite-tsconfig-paths": "6.1.1"
  },
  "devDependencies": {
    "@gewis/eslint-config-react": "2.4.0",
    "@gewis/eslint-config-typescript": "2.4.0",
    "@gewis/prettier-config": "2.2.2",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react-swc": "4.3.3",
    "eslint": "9.39.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
